{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:lib": "ng build pl-core-utils-library",
    "pack:lib": "npm run build:lib && cd dist/pl-core-utils-library && npm pack",
    "verify:lib": "npm run check:lib-package && npm run build:lib && npm run pack:lib",
    "test": "ng test",
    "publish:lib:dry": "npm run build:pack && cd dist/pl-core-utils-library && npm publish --dry-run",
    "publish:lib": "npm run build:pack && cd dist/pl-core-utils-library && npm publish",
    "version:lib:patch": "cd projects/pl-core-utils-library && npm version patch --no-git-tag-version",
    "version:lib:minor": "cd projects/pl-core-utils-library && npm version minor --no-git-tag-version",
    "version:lib:major": "cd projects/pl-core-utils-library && npm version major --no-git-tag-version",
    "prepublish:lib": "npm run verify:lib && npm run publish:lib:dry",
    "check:lib-package": "node scripts/check-lib-package.cjs"
  },
  "dependencies": {
    "@angular/animations": "^19.2.1",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.1",
    "@angular/compiler": "^19.2.1",
    "@angular/core": "^19.2.1",
    "@angular/forms": "^19.2.1",
    "@angular/localize": "^19.2.22",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.1",
    "@angular/platform-browser-dynamic": "^19.2.1",
    "@angular/router": "^19.2.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@ng-bootstrap/ng-bootstrap": "^18.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "axios": "^0.27.2",
    "bootstrap": "^5.3.3",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jquery": "^3.7.1",
    "moment": "^2.30.1",
    "ngx-ui-loader": "^13.0.0",
    "pl-core-utils-library": "file:projects/pl-core-utils-library",
    "pl-decorator": "^1.4.28",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.4",
    "@angular/cli": "~19.2.1",
    "@angular/compiler-cli": "^19.2.1",
    "@compodoc/compodoc": "^1.1.26",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.0.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.0",
    "typescript": "~5.8.2"
  }
}