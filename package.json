{
  "name": "app",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "test": "ng test",
    "lint": "ng lint",
    "typedoc": "compodoc -d public/pl-core-utils-library/documentation -p tsconfig.json -s -n Portable-Core --theme Postmark --disablePrivate --disableCoverage --disableStyleTab --disableTemplateTab --hideGenerator --disableSourceCode",
    "sonar": "sonar-scanner",
    "build-dev": "ng build --project=pl-core-utils-library",
    "build-prod": "ng build --aot --source-map=false",
    "build:lib": "ng build pl-core-utils-library",
    "pack:lib": "npm run build:lib && cd dist/pl-core-utils-library && npm pack"
  },
  "dependencies": {
    "@angular/animations": "^19.2.1",
    "@angular/cdk": "^19.2.19",
    "@angular/common": "^19.2.1",
    "@angular/compiler": "^19.2.1",
    "@angular/core": "^19.2.1",
    "@angular/forms": "^19.2.1",
    "@angular/localize": "^19.2.22",
    "@angular/material": "^19.2.19",
    "@angular/platform-browser": "^19.2.1",
    "@angular/platform-browser-dynamic": "^19.2.1",
    "@angular/router": "^19.2.1",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@ng-bootstrap/ng-bootstrap": "^18.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "angular2-uuid": "^1.1.1",
    "axios": "^0.27.2",
    "bootstrap": "^5.3.3",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "jquery": "^3.7.1",
    "moment": "^2.30.1",
    "ngx-ui-loader": "^13.0.0",
    "pl-core-utils-library": "file:projects/pl-core-utils-library",
    "pl-decorator": "^1.4.28",
    "popper.js": "^1.16.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.4",
    "@angular/cli": "~19.2.1",
    "@angular/compiler-cli": "^19.2.1",
    "@compodoc/compodoc": "^1.1.26",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^22.0.0",
    "jasmine-core": "~5.6.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^19.2.0",
    "typescript": "~5.8.2"
